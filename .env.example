# Copy to .env and edit. .env is gitignored.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# Easiest path: apply the Terraform, then run
#   cd terraform && terraform output -raw pipeline_env
# and paste the result here.

# ---- Local execution (all optional; defaults shown) -------------------------
# PIPELINE_DATA_DIR=./data
# PIPELINE_DUCKDB_PATH=./data/local/warehouse.duckdb
# PIPELINE_STATE_PATH=./data/local/watermarks.json

# Days of already-loaded history to re-read on each run, so upstream revisions
# to recently published values are picked up. The upsert makes this safe.
# PIPELINE_LOOKBACK_DAYS=7

# Set false to log data-quality failures as warnings instead of failing the run.
# PIPELINE_FAIL_ON_QUALITY_ERROR=true

# LOG_LEVEL=INFO

# ---- Cloud execution (required only for run-cloud / estimate-cost) ----------
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=market-pipeline-raw-dev-my-gcp-project-id
BQ_DATASET=market_analytics
BQ_LOCATION=US

# NOTE: there is deliberately no variable for a service-account key file.
# Authentication uses Application Default Credentials:
#   gcloud auth application-default login
# or, for the pipeline service account, impersonation:
#   gcloud auth application-default login --impersonate-service-account=<SA_EMAIL>
# Never commit a key file; .gitignore blocks the common names.
